# Copy to .env for local dev. Use an absolute folder path if overriding DATA_DIR.
PORT=8080
ADMIN_PORT=8081
INGESTER_PORT=8082
BIND_ADDR=127.0.0.1
# HTTPS deployment must use true. dev.sh explicitly defaults false on loopback.
ADMIN_SECURE_COOKIES=true
INGESTER_INTERVAL_SECONDS=60
FETCH_IMAGES=false
# Public contact shown on /advertise; leave blank until the owner supplies it.
CONTACT_EMAIL=
